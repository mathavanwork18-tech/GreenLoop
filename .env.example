# ==============================================================================
# EcoCircuit / Green Loop — Master Environment Template
# ==============================================================================

# Supabase Credentials (Database & Auth Authority)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# Database Connection (PostgreSQL / MongoDB)
DATABASE_URL=
MONGODB_URI=

# Google Gemini API Key (Multimodal Product Inspection & Circular AI)
GEMINI_API_KEY=

# Razorpay Payment Gateway (Server-Side Secret & Client Key)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS Gateway (Optional Standalone Testing)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_TEST_TO=
VONAGE_SENDER_ID=GreenLoop

# Rate Limiting Configuration
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=60000
AI_RATE_LIMIT=30
AI_RATE_WINDOW_MS=60000
PAYMENT_RATE_LIMIT=30
PAYMENT_RATE_WINDOW_MS=60000
API_RATE_LIMIT=120
API_RATE_WINDOW_MS=60000

# Server & Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:3000
