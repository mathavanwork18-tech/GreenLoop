# ==============================================================================
# EcoCircuit / Green Loop — Backend Environment Configuration Template
# ==============================================================================

PORT=5000
NODE_ENV=development

# Client Origins for CORS (comma separated)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Google Gemini API Key for Multimodal Product Analysis
GEMINI_API_KEY=

# Razorpay Payments Gateway (Server-side)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Database Connection (Optional MongoDB)
MONGODB_URI=

# Supabase Admin / Service Role Credentials (Server-only scripts)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SMS Gateway (Optional Standalone Test Only)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_TEST_TO=
VONAGE_SENDER_ID=GreenLoop

# Rate Limiting Configuration
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=60000
AI_RATE_LIMIT=30
AI_RATE_WINDOW_MS=60000
PAYMENT_RATE_LIMIT=30
PAYMENT_RATE_WINDOW_MS=60000
API_RATE_LIMIT=120
API_RATE_WINDOW_MS=60000
